<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfraOrgIt.Api\InfraOrgIt.Api.csproj" />
    <ProjectReference Include="..\..\tools\LegacyImport\LegacyImport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Legacy/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\LegacyImport\fixtures\rehearsal.json"
          Link="Legacy/Fixtures/import-rehearsal.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\infraorgit-docker\legacy\*.sql"
          Link="Legacy/Sql\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>